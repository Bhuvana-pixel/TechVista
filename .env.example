# ==========================================
# TechVista Environment Configuration
# ==========================================

# Database
# For Render / Neon / Supabase PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xyz.neon.tech/techvista?sslmode=require
# For local SQLite fallback (leave blank or use sqlite):
DATABASE_URL=sqlite:///./techvista.db

# JWT & Authentication
JWT_SECRET=super_secret_techvista_jwt_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


ENVIRONMENT=development
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://techvista.vercel.app

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional External API Keys (External Data Providers)
NEWS_API_KEY=
FINANCIAL_DATA_API_KEY=
PATENTS_API_KEY=
